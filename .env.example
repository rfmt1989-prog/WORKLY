# Web production uses the same-origin FastAPI endpoint.
EXPO_PUBLIC_API_URL=/api

# For a physical mobile device in local development, replace this with the
# computer's LAN address, for example http://192.168.1.50:8000/api.
# EXPO_PUBLIC_API_URL=http://192.168.1.50:8000/api

# Optional production-only signing key. Never commit the real value.
WORKLY_TOKEN_SECRET=replace-with-a-long-random-value

# Optional comma-separated origins for local or custom-domain deployments.
WORKLY_CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081

