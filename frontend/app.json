{
  "expo": {
    "name": "WORKLY",
    "slug": "workly",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "workly",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "pt.workly.app",
      "infoPlist": {
        "NSFaceIDUsageDescription": "Entrar no WORKLY com Face ID"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#EAF2F4"
      },
      "edgeToEdgeEnabled": true,
      "package": "pt.workly.app"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Entrar no WORKLY com Face ID"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-image.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F5F7F8"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "owner": "maia239",
    "extra": {
      "eas": {
        "projectId": "00e6fda1-e9f7-4f62-bfac-8ed7273592c7"
      }
    }
  }
}
